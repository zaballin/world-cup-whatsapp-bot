{
  "name": "world-cup-whatsapp-bot",
  "version": "1.0.0",
  "description": "Family WhatsApp bot that reads Google Sheets leaderboard and posts daily World Cup pool updates",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "send:update": "tsx src/cli/sendUpdate.ts",
    "dry-run": "tsx src/cli/sendUpdate.ts --dry-run",
    "test": "vitest",
    "lint": "eslint .",
    "build": "tsc"
  },
  "keywords": [
    "world-cup",
    "whatsapp",
    "google-sheets",
    "pool"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "node-cron": "^3.0.3",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "whatsapp-web.js": "^1.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}
